# Set to false to use real LLM via HAI proxy, true for keyword-only fallback
MOCK_BEDROCK=false

# HAI Proxy (OpenAI-compatible Anthropic endpoint)
LLM_PROXY_URL=http://localhost:6655
LLM_PROXY_API_KEY=your-hai-proxy-api-key-here
LLM_PROXY_MODEL=claude-sonnet-4-5
LLM_PROXY_PATH=/anthropic/v1/messages
